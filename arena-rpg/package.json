{
  "name": "arena-rpg",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "node scripts/check-node.mjs && node scripts/dev.mjs",
    "dev:tunnel": "node scripts/check-node.mjs && node scripts/dev.mjs --tunnel",
    "mobile": "node scripts/check-node.mjs && npm run start -w @arena/mobile",
    "mobile:tunnel": "node scripts/check-node.mjs && npm run start -w @arena/mobile -- --tunnel",
    "server": "node scripts/check-node.mjs && npm run dev -w @arena/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "legal:docs": "tsx scripts/legal-docs.ts"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
