# Copy to .env and fill in. Never commit the real .env.

# Your API domain; its DNS A record must point to this server's IP.
DOMAIN=api.ornekoyun.com

# Mail for verification codes and admin notifications (from your mail provider).
SMTP_URL=smtps://kullanici:sifre@smtp.saglayici.com:465
MAIL_FROM=Toz ve Demir <no-reply@ornekoyun.com>
ADMIN_NOTIFY_EMAIL=sen@ornekoyun.com

# Random secret, at least 16 characters, e.g. from: openssl rand -hex 24
PROPHECY_SECRET=

# Optional: only these IPs can open /admin (comma separated). Empty = everyone sees the login page.
ADMIN_ALLOWED_IPS=
