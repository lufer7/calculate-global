# PRGTURK — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyala. Gerçek .env dosyaları git'e GİRMEZ.
# Kural (§0): Buraya yalnızca bu projeye ait KİŞİSEL hesaplardan alınmış anahtarlar girer.
# Ajansın / işverenin hiçbir anahtarı, servis hesabı veya BigQuery projesi kullanılmaz.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://prgturk.com

# --- Supabase (public: client'a gidebilir) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER-ONLY: asla NEXT_PUBLIC_ önekiyle tanımlama) ---
SUPABASE_SERVICE_ROLE_KEY=
# Supabase > Project Settings > Database > Connection string (Transaction pooler, port 6543)
DATABASE_URL=

# --- Admin ---
# Admin paneline girebilecek e-postalar, virgülle ayrılmış
ADMIN_EMAILS=

# --- Cron (Vercel Cron Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=
ADSTXT_CRON_LIMIT=40
CRUX_MAX_RANK=1000000

# --- Sonraki fazlar (şimdilik boş kalabilir) ---
# P3/P4: Anthropic API — server-side only
ANTHROPIC_API_KEY=
# P2: Cloudflare Radar API token (kişisel hesap)
CLOUDFLARE_API_TOKEN=
# P2: CrUX ingest için KİŞİSEL GCP projesi
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=
